# {{ ansible_managed }}
[Unit]
Description=Write health.json and push to Uptime Kuma whether every expected container is running
After=docker.service

[Service]
Type=oneshot
# deploy is in the docker group: it only runs `docker inspect`.
User={{ deploy_user }}
EnvironmentFile=/etc/container-watch.env
# "-": a failing snapshot never blocks the push to Kuma (the stopped-container alert).
ExecStart=-/usr/local/bin/status-snapshot
ExecStart=/usr/local/bin/container-watch
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
