#!/usr/bin/env bash
# Dispatches the newsletter workflow (GITHUB_REPO, GITHUB_TOKEN from the systemd EnvironmentFile).
# The token goes to curl through stdin, so it never shows up in the process list.
set -euo pipefail

url="https://api.github.com/repos/${GITHUB_REPO}/actions/workflows/newsletter.yml/dispatches"
body='{"ref":"main","inputs":{"edition":"auto","dry_run":"false","skip_if_sent":"true"}}'

curl --config - --fail-with-body --silent --show-error --max-time 30 \
  --retry 5 --retry-delay 30 --retry-all-errors \
  --request POST --data "$body" "$url" <<CONFIG
header = "Authorization: Bearer ${GITHUB_TOKEN}"
header = "Accept: application/vnd.github+json"
header = "X-GitHub-Api-Version: 2022-11-28"
CONFIG
echo "newsletter dispatched on ${GITHUB_REPO}"
