#!/usr/bin/env bash
# Every 10 minutes: asks the app which newsletter edition is due (`flanews due`, from the match
# calendar) and dispatches the workflow for it, once per edition (labels kept in the state file).
# The Actions hourly cron is the backup. The token goes to curl through stdin, never in argv.
set -euo pipefail

state="${STATE_DIRECTORY:-/var/lib/newsletter-trigger}/dispatched"
touch "$state"

# stdout: "kind<TAB>YYYY-MM-DD<TAB>label" or nothing; logs go to stderr (the journal).
due=$(docker compose -f "$COMPOSE_FILE" exec -T flamengo-news python -m flanews due)
if [ -z "$due" ]; then
  exit 0
fi
IFS=$'\t' read -r kind day label <<<"$due"
if grep -qxF "$label" "$state"; then
  echo "already dispatched: $label"
  exit 0
fi

url="https://api.github.com/repos/${GITHUB_REPO}/actions/workflows/newsletter.yml/dispatches"
body=$(printf '{"ref":"main","inputs":{"edition":"%s","date":"%s","dry_run":"false","skip_if_sent":"true"}}' "$kind" "$day")

curl --config - --fail-with-body --silent --show-error --max-time 30 \
  --retry 5 --retry-delay 30 --retry-all-errors \
  --request POST --data "$body" "$url" <<CONFIG
header = "Authorization: Bearer ${GITHUB_TOKEN}"
header = "Accept: application/vnd.github+json"
header = "X-GitHub-Api-Version: 2022-11-28"
CONFIG
echo "$label" >>"$state"
echo "dispatched: $label"
