# {{ ansible_managed }}
[Unit]
Description=Send the Urubu News every Monday and Friday at 08:00 BRT

[Timer]
# No Persistent=: a late catch-up after a reboot could send the wrong edition; the Actions cron covers it.
OnCalendar={{ newsletter_trigger_schedule }}
AccuracySec=1s

[Install]
WantedBy=timers.target
