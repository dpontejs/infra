# {{ ansible_managed }}
PUBLIC_URL={{ geral_public_url }}
NEWSLETTER_FROM={{ geral_sender }}
SUBSCRIBE_SECRET={{ lookup('env', 'GERAL_SUBSCRIBE_SECRET') }}
SUBSCRIBERS_API_TOKEN={{ lookup('env', 'GERAL_API_TOKEN') }}
RESEND_API_KEY={{ lookup('env', 'FLAMENGO_NEWS_RESEND_API_KEY') }}
NOTIFY_EMAIL={{ lookup('env', 'FLAMENGO_NEWS_NOTIFY_EMAIL') }}
# The Urubu News moved in: its links (signed with its secret) act on the flamengo team.
LEGACY_TEAM=flamengo
LEGACY_SUBSCRIBE_SECRET={{ lookup('env', 'FLAMENGO_NEWS_SUBSCRIBE_SECRET') }}
LEGACY_HOSTS=urubunews.{{ domain }},flamengo.{{ domain }}
