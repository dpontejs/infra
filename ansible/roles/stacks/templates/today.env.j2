# {{ ansible_managed }}
# Single quotes: the Argon2 hash contains `$`, which Compose would otherwise interpolate.
PASSPHRASE_HASH='{{ lookup('env', 'TODAY_PASSPHRASE_HASH') }}'
SESSION_SECRET={{ lookup('env', 'TODAY_SESSION_SECRET') }}
# Enables /mcp (MCP server for Claude Code), see today's ADR 0005.
API_TOKEN={{ lookup('env', 'TODAY_API_TOKEN') }}
# Natural-language capture (shared Gemini key, see today's ADR 0003).
GEMINI_API_KEY={{ lookup('env', 'TODAY_GEMINI_API_KEY') }}
# Web push (feature 05 of today). Rotating the keys invalidates every device subscription.
VAPID_PRIVATE_KEY={{ lookup('env', 'TODAY_VAPID_PRIVATE_KEY') }}
VAPID_PUBLIC_KEY={{ lookup('env', 'TODAY_VAPID_PUBLIC_KEY') }}
VAPID_SUBJECT={{ lookup('env', 'TODAY_VAPID_SUBJECT') }}
# Job collection (feature 07 of today) at 07/13/19h. LinkedIn stays off until its fixture is re-recorded.
JOBS_ENABLED=true
JOBS_SOURCES=greenhouse:ifoodcarreiras,greenhouse:inter,greenhouse:c6bank,greenhouse:xpinc,greenhouse:btgpactual,greenhouse:quintoandar,greenhouse:stone,greenhouse:vtex,greenhouse:wildlifestudios,greenhouse:hotmartcareersbr,gupy,ashby:nubank,lever:ciandt,eightfold:mercadolibre,oracle:picpay,himalayas,remotar
# Job pre-analysis with `claude -p` on the owner's subscription (today's ADR 0007).
ANALYST=claude_cli
CLAUDE_CODE_OAUTH_TOKEN={{ lookup('env', 'TODAY_CLAUDE_CODE_OAUTH_TOKEN') }}
# The root filesystem is read-only; Claude Code writes its config under $HOME, so it lives in the /tmp tmpfs.
HOME=/tmp
