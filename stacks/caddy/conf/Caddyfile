# Caddy obtains and renews HTTPS certificates (Let's Encrypt) for every site below on its own.
# {$VAR} placeholders come from the container environment (written by Ansible to .env):
#   DOMAIN       e.g. diegoponte.dev
#   ADMIN_CIDRS  space-separated CIDRs allowed into admin panels

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Portfolio: its own container (stacks/portfolio), which already compresses and sets cache headers.
{$DOMAIN} {
	import security_headers
	reverse_proxy portfolio:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Urubu News: newsletter sign-up page (stacks/flamengo-news). /api/* checks its own token.
urubunews.{$DOMAIN} {
	import security_headers
	reverse_proxy flamengo-news:8000
}

# Old address of the same page. E-mails already sent link here (unsubscribe, one-click POST from
# Gmail, confirmation, logo), and not every client follows redirects: only the home page moves.
flamengo.{$DOMAIN} {
	import security_headers
	redir / https://urubunews.{$DOMAIN}/ permanent
	reverse_proxy flamengo-news:8000
}

# Uptime Kuma: admin panel, only reachable from ADMIN_CIDRS.
status.{$DOMAIN} {
	import security_headers
	# Access log (JSON to stdout, rotated by Docker): who reached the admin panel, from which IP.
	log
	@outsiders not remote_ip {$ADMIN_CIDRS}
	respond @outsiders "Forbidden" 403
	reverse_proxy uptime-kuma:3001
}
