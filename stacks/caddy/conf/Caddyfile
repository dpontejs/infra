# Caddy obtains and renews HTTPS certificates (Let's Encrypt) for every site below on its own.
# {$VAR} placeholders come from the container environment (written by Ansible to .env):
#   DOMAIN       e.g. diegoponte.dev
#   ADMIN_CIDRS  space-separated CIDRs allowed into admin panels

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Portfolio: its own container (stacks/portfolio), which already compresses and sets cache headers.
{$DOMAIN} {
	import security_headers
	reverse_proxy portfolio:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Urubu News: moved into the Geral (geral repo, docs/adr/0001). E-mails already sent link here
# (unsubscribe, one-click POST from Gmail, bets, ranking, logo): the Geral answers them with the old
# signing secret; its home page redirects to the Geral portal. stacks/flamengo-news stays up, unrouted,
# as the way back.
urubunews.{$DOMAIN} {
	import security_headers
	reverse_proxy geral:8000
}

# Oldest address of the Urubu News: same as above (the Geral redirects its home page too).
flamengo.{$DOMAIN} {
	import security_headers
	reverse_proxy geral:8000
}

# Geral: newsletters per team (stacks/geral). /api/* checks its own token.
geral.{$DOMAIN} {
	import security_headers
	reverse_proxy geral:8000
}

# today: reminders PWA (stacks/today). Login, session and rate limit live in the app.
today.{$DOMAIN} {
	import security_headers
	reverse_proxy today:8000
}

# Uptime Kuma: admin panel, only reachable from ADMIN_CIDRS.
status.{$DOMAIN} {
	import security_headers
	# Access log (JSON to stdout, rotated by Docker): who reached the admin panel, from which IP.
	log
	@outsiders not remote_ip {$ADMIN_CIDRS}
	respond @outsiders "Forbidden" 403
	reverse_proxy uptime-kuma:3001
}

# EdutorIA: internal demo of a separate project (github.com/dpontejs/edutor-ia), deployed from its own
# compose files in /opt/stacks/edutoria. Its own Caddy routes the SPA, the API, auth and signed S3 URLs
# over plain HTTP inside the `web` network; TLS ends here. 16 MB covers its largest upload (a PDF).
edutoria.{$DOMAIN} {
	import security_headers
	request_body {
		max_size 16MB
	}
	reverse_proxy edutoria-web:80
}
