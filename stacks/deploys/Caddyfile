# Only reachable through the main Caddy (deploys.{$DOMAIN}, ADMIN_CIDRS only).
{
	admin off
	auto_https off
}

:8080 {
	header -Server
	handle /state/* {
		# Changes every minute: never cache it.
		header Cache-Control "no-store"
		uri strip_prefix /state
		root * /srv/state
		file_server
	}
	handle {
		root * /srv/www
		file_server
	}
}
